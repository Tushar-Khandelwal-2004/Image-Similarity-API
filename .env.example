# Optional protection for POST /v1/compare.
API_KEY=

# Comma-separated browser origins, or * for development.
CORS_ORIGIN=

# In-memory per-process limits.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
MAX_CONCURRENT_COMPARISONS=2
MAX_QUEUED_COMPARISONS=8

# Set only when the reverse proxy supplies a trusted client IP.
TRUST_PROXY=false
