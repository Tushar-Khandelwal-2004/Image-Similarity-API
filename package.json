{
  "name": "image-similarity-api",
  "version": "0.1.0",
  "private": true,
  "description": "One-day MVP for comparing original and suspect images.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench:data": "tsx bench/data.ts",
    "bench": "tsx bench/run.ts",
    "bench:quick": "tsx bench/run.ts --quick",
    "readme:bench": "tsx scripts/update-readme-bench.ts",
    "deploy:space": "tsx scripts/deploy-space.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "@xenova/transformers": "^2.17.2",
    "fastify": "^5.2.1",
    "sharp": "0.32.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
